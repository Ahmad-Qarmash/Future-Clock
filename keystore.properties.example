# Copy this file to keystore.properties in the project root. It is intentionally gitignored.
# Do not commit the copied file or your upload key.

# Android upload key for the Google Play release bundle.
storeFile=C:/path/to/futureclock-release.jks
storePassword=replace-with-store-password
keyAlias=futureclock
keyPassword=replace-with-key-password

# AdMob values from your AdMob dashboard. Debug builds always use Google test ads.
admobAppId=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
admobBannerAdUnitId=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
