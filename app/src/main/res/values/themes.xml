<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FutureClock.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_brand_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/on_brand_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorError">@color/status_error</item>
        <item name="colorErrorContainer">@color/status_error_container</item>

        <item name="android:colorBackground">@color/bg_base</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorSurfaceVariant">@color/bg_surface_alt</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowLightStatusBar">@bool/is_light_theme</item>
        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FutureClock.Dialog</item>
        <item name="bottomNavigationStyle">@style/Widget.FutureClock.BottomNav</item>
        <item name="materialButtonStyle">@style/Widget.FutureClock.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.FutureClock.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.FutureClock.Card</item>
        <item name="materialSwitchStyle">@style/Widget.FutureClock.Switch</item>
        <item name="chipStyle">@style/Widget.FutureClock.Chip</item>
        <item name="floatingActionButtonStyle">@style/Widget.FutureClock.Fab</item>
    </style>

    <style name="Theme.FutureClock" parent="Theme.FutureClock.Base" />

    <style name="Theme.FutureClock.Alarm" parent="Theme.FutureClock">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="Theme.FutureClock.Dialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FutureClock.Dialog</item>
    </style>

    <style name="ThemeOverlay.FutureClock.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.FutureClock.Dialog</item>
    </style>

    <style name="ShapeAppearance.FutureClock.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.FutureClock.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/nav_bar</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.FutureClock.BottomNav.Indicator</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
    </style>

    <style name="Widget.FutureClock.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_primary_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FutureClock.Pill</item>
    </style>

    <style name="ShapeAppearance.FutureClock.Pill" parent="ShapeAppearance.Material3.Corner.Full" />

    <style name="Widget.FutureClock.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.FutureClock.Button.Primary" parent="Widget.FutureClock.Button">
        <item name="backgroundTint">@color/selector_primary_button_bg</item>
        <item name="android:textColor">@color/selector_primary_button_text</item>
        <item name="iconTint">@color/selector_primary_button_text</item>
    </style>

    <style name="Widget.FutureClock.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/selector_outline</item>
        <item name="android:textColor">@color/selector_secondary_button_text</item>
        <item name="iconTint">@color/selector_secondary_button_text</item>
    </style>

    <style name="Widget.FutureClock.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/selector_secondary_button_text</item>
    </style>

    <style name="Widget.FutureClock.Button.Destructive" parent="Widget.FutureClock.Button.Outlined">
        <item name="strokeColor">@color/status_error</item>
        <item name="android:textColor">@color/status_error</item>
        <item name="iconTint">@color/status_error</item>
    </style>

    <style name="Widget.FutureClock.Button.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/selector_secondary_button_text</item>
        <item name="strokeColor">@color/selector_outline</item>
    </style>

    <style name="Widget.FutureClock.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="backgroundTint">@color/bg_surface_alt</item>
    </style>

    <style name="Widget.FutureClock.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="hintTextColor">@color/selector_input_hint</item>
        <item name="boxBackgroundColor">@color/bg_surface</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.FutureClock.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/elevation_low</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
    </style>

    <style name="Widget.FutureClock.Card.Flat" parent="Widget.FutureClock.Card">
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.FutureClock.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minWidth">52dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.FutureClock.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">48dp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="chipBackgroundColor">@color/selector_chip_bg</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="chipStrokeColor">@color/selector_outline</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <style name="Widget.FutureClock.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="tint">@color/on_brand_primary</item>
        <item name="elevation">@dimen/elevation_medium</item>
        <item name="pressedTranslationZ">2dp</item>
    </style>

    <style name="TextAppearance.FutureClock.Display" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="TextAppearance.FutureClock.ScreenTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.FutureClock.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.FutureClock.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FutureClock.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.FutureClock.Eyebrow" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
