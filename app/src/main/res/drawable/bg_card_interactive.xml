<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_primary_container" />
            <stroke android:width="2dp" android:color="@color/brand_primary" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_alt" />
            <stroke android:width="1dp" android:color="@color/focus_ring" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <stroke android:width="1dp" android:color="@color/divider" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
</selector>
