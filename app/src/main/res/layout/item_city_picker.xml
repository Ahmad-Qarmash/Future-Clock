<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:background="@drawable/bg_card_interactive"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_s">

    <TextView
        android:id="@+id/leading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="24sp"
        tools:text="🇺🇸" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_s"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.FutureClock.Section"
            tools:text="New York City" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.FutureClock.Caption"
            tools:text="New York, United States · America/New_York" />
    </LinearLayout>

    <TextView
        android:id="@+id/trailing"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/brand_primary"
        android:textSize="24sp"
        tools:text="›" />
</LinearLayout>
