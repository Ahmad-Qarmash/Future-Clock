<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xxl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_timer"
            android:textAppearance="@style/TextAppearance.FutureClock.ScreenTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/timer_subtitle"
            android:textAppearance="@style/TextAppearance.FutureClock.Body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/timer_presets"
            android:textAppearance="@style/TextAppearance.FutureClock.Section" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/preset_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/chip_1m" style="@style/Widget.FutureClock.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/timer_preset_1" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_3m" style="@style/Widget.FutureClock.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/timer_preset_3" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_5m" style="@style/Widget.FutureClock.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/timer_preset_5" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_10m" style="@style/Widget.FutureClock.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/timer_preset_10" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_30m" style="@style/Widget.FutureClock.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/timer_preset_30" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FutureClock.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <com.futureclock.app.ui.views.CircularTimerView
                    android:id="@+id/circular_timer"
                    android:layout_width="260dp"
                    android:layout_height="260dp" />

                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_status_info"
                    android:textAppearance="@style/TextAppearance.FutureClock.Eyebrow"
                    tools:text="READY" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset"
                style="@style/Widget.FutureClock.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:text="@string/action_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_primary"
                style="@style/Widget.FutureClock.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:text="@string/action_start" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
