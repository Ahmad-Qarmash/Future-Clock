<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <TimePicker
            android:id="@+id/time_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner"
            android:theme="@style/Theme.FutureClock" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:hint="@string/alarm_label_hint"
            style="@style/Widget.FutureClock.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/alarm_repeat"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_caption"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/days_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:singleSelection="false"
            app:chipSpacingHorizontal="4dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_mon"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/day_short_mon" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_tue"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/day_short_tue" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_wed"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/day_short_wed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_thu"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/day_short_thu" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_fri"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/day_short_fri" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sat"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/day_short_sat" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sun"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/day_short_sun" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/alarm_snooze_minutes"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_subtitle" />

            <TextView
                android:id="@+id/snooze_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/neon_cyan"
                android:textSize="@dimen/text_subtitle"
                tools:text="5 min" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/snooze_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="30"
            android:stepSize="1"
            android:value="5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/alarm_vibrate"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_subtitle" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_vibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_gradual_volume"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_subtitle" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_gradual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_xxl"
            android:text="@string/action_save"
            app:backgroundTint="@color/neon_cyan"
            android:textColor="@color/bg_base" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/action_delete"
            android:visibility="gone"
            style="@style/Widget.FutureClock.Button.Outlined" />

    </LinearLayout>
</ScrollView>
