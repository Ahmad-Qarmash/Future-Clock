<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_padding"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:id="@+id/text_screen_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_new_title"
                android:textAppearance="@style/TextAppearance.FutureClock.ScreenTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/alarm_subtitle"
                android:textAppearance="@style/TextAppearance.FutureClock.Body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/alarm_schedule_section"
            android:textAppearance="@style/TextAppearance.FutureClock.Section" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FutureClock.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TimePicker
                    android:id="@+id/time_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/timezone_card"
                    style="@style/Widget.FutureClock.Card.Flat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="112dp"
                    app:rippleColor="@color/brand_primary_container"
                    app:strokeColor="@color/selector_outline">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/timezone_flag"
                                android:layout_width="@dimen/touch_target"
                                android:layout_height="@dimen/touch_target"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:textSize="25sp"
                                tools:text="🇺🇸" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/timezone_picker"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:textAppearance="@style/TextAppearance.FutureClock.Section"
                                    tools:text="Los Angeles" />

                                <TextView
                                    android:id="@+id/timezone_id"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    android:textColor="@color/brand_primary"
                                    android:textSize="@dimen/text_caption"
                                    tools:text="America/Los_Angeles" />

                                <TextView
                                    android:id="@+id/timezone_country"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    android:textAppearance="@style/TextAppearance.FutureClock.Caption"
                                    tools:text="California, United States" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_change_timezone"
                                style="@style/Widget.FutureClock.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/touch_target"
                                android:text="@string/action_change" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/timezone_current"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body"
                            tools:text="20:14 · PDT · UTC−07:00 · Today" />

                        <TextView
                            android:id="@+id/timezone_source"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:background="@drawable/bg_status_info"
                            android:paddingHorizontal="@dimen/space_s"
                            android:paddingVertical="@dimen/space_xs"
                            android:text="@string/alarm_timezone_from_world"
                            android:textColor="@color/brand_primary"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FutureClock.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:hint="@string/alarm_label_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/alarm_repeat"
                    android:textAppearance="@style/TextAppearance.FutureClock.Caption"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/days_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    app:singleSelection="false">

                    <com.google.android.material.chip.Chip android:id="@+id/chip_mon" style="@style/Widget.FutureClock.Chip" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/day_short_mon" />
                    <com.google.android.material.chip.Chip android:id="@+id/chip_tue" style="@style/Widget.FutureClock.Chip" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/day_short_tue" />
                    <com.google.android.material.chip.Chip android:id="@+id/chip_wed" style="@style/Widget.FutureClock.Chip" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/day_short_wed" />
                    <com.google.android.material.chip.Chip android:id="@+id/chip_thu" style="@style/Widget.FutureClock.Chip" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/day_short_thu" />
                    <com.google.android.material.chip.Chip android:id="@+id/chip_fri" style="@style/Widget.FutureClock.Chip" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/day_short_fri" />
                    <com.google.android.material.chip.Chip android:id="@+id/chip_sat" style="@style/Widget.FutureClock.Chip" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/day_short_sat" />
                    <com.google.android.material.chip.Chip android:id="@+id/chip_sun" style="@style/Widget.FutureClock.Chip" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/day_short_sun" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/alarm_preferences_section"
            android:textAppearance="@style/TextAppearance.FutureClock.Section" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FutureClock.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_snooze_duration" android:textColor="@color/text_primary" android:textSize="@dimen/text_subtitle" />
                    <TextView android:id="@+id/snooze_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status_info" android:textColor="@color/brand_primary" android:textStyle="bold" tools:text="5 min" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/snooze_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="5"
                    android:valueFrom="1"
                    android:valueTo="30" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/alarm_vibrate" android:textColor="@color/text_primary" android:textSize="@dimen/text_subtitle" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_vibrate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_gradual_volume" android:textColor="@color/text_primary" android:textSize="@dimen/text_subtitle" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_gradual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:elevation="@dimen/elevation_high"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_m">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/saving_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/alarm_saving"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                style="@style/Widget.FutureClock.Button.Destructive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/action_delete"
                android:textColor="@color/status_error"
                android:visibility="gone"
                app:strokeColor="@color/status_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.FutureClock.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="@string/action_save" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
